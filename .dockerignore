# Keeps the image build context small, and free of host-specific binaries and secrets.
# Host node_modules would overwrite the Linux ones installed inside the image.
**/node_modules
**/dist
**/*.tsbuildinfo
coverage
screenshots
**/*.log

# Secrets: configuration comes from the platform's environment, never a baked-in .env.
.env
.env.*
!.env.example

.git
.vscode
.idea
