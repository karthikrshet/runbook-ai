# RunbookAI dashboard. Copy to .env and fill in; never commit .env.
# On TrueFoundry, set these as the service's environment variables instead
# (see truefoundry.yaml and TRUEFOUNDRY.md); the image never contains a .env.

# Where the dashboard server calls TrueForge's API.
TRUEFORGE_BASE_URL=http://localhost:8790

# Where a browser opens TrueForge's UI, when that differs from TRUEFORGE_BASE_URL
# (for example, the dashboard reaches TrueForge on an in-cluster address).
TRUEFORGE_PUBLIC_URL=

# Only needed if auth is enabled on your TrueForge server. Stays server-side;
# the browser never receives it.
TRUEFORGE_TOKEN=

# The TrueForge agent that runs started from the dashboard use.
TRUEFORGE_AGENT_NAME=runbookai

# Connector names as configured in TrueForge (Settings -> Connectors).
# Structured results are only trusted from the RunbookAI connector.
RUNBOOKAI_MCP_SERVER_NAME=runbookai
GITHUB_MCP_SERVER_NAME=github

# The dashboard is view-only by default. A write requires all of:
# - DASHBOARD_SOURCE=trueforge
# - the corresponding feature toggle below set to on
# - the exact acknowledgement value below
# This protects against accidentally forwarding dashboard actions to TrueForge.
DASHBOARD_DECISIONS=off
DASHBOARD_START_RUNS=off
DASHBOARD_TRUEFORGE_WRITE_ACK=
# Exact required acknowledgement value (do not copy into a committed file):
# I_UNDERSTAND_TRUEFORGE_WRITES

# trueforge (the default) or fixture: a synthetic replay for demos and UI work,
# labelled as demo data everywhere. The --source flag overrides this.
DASHBOARD_SOURCE=

# Optional label for the environment badge in the header, e.g. "Controlled demo".
DASHBOARD_ENVIRONMENT=

# Dashboard server. Binds to loopback by default; containers use 0.0.0.0.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8791
DASHBOARD_POLL_MS=1500

# Host names browsers use to reach the dashboard when it is not on loopback,
# comma-separated, e.g. runbook.example.com (add :port for a non-default port).
# Any other Host header is refused, which protects the API from DNS rebinding.
DASHBOARD_ALLOWED_HOSTS=

# Directory of Markdown runbooks for the start screen. Default: runbooks/.
RUNBOOKAI_RUNBOOKS_DIR=
