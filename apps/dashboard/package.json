{
  "name": "@runbook-ai/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only RunbookAI view over a live TrueForge session.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../../packages/core/src server/main.ts --dev",
    "dev:fixture": "tsx watch --clear-screen=false --include ../../packages/core/src server/main.ts --dev --source=fixture",
    "build": "vite build",
    "start": "tsx server/main.ts",
    "start:fixture": "tsx server/main.ts --source=fixture",
    "start:live": "tsx server/main.ts --source=trueforge --port=8792 --env=Live",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@runbook-ai/core": "0.1.0",
    "@truefoundry/trueforge-sdk": "0.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.1"
  }
}
